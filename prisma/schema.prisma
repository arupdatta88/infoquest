generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SearchHistory {
  id          String   @id @default(cuid())
  keyword     String
  engine      String   @default("web")
  language    String   @default("en")
  reportData  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
